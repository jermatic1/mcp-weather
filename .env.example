# Home location in decimal degrees.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# Contact details sent to the National Weather Service in the User-Agent, as they ask.
WEATHER_CONTACT="you@example.com"

# Optional: name used when describing the location to the assistant.
WEATHER_LOCATION_NAME=home

# Optional: observation station ID (e.g. KBOS) instead of the nearest one.
WEATHER_STATION=

# Optional: time zone for observation times.
TZ=America/Chicago
